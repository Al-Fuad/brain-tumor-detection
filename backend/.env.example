# Brain Tumor Detection Backend Environment Variables
APP_NAME="Brain Tumor Detection API"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Path to the Keras model artifact
# When deployed, can be mounted or set to relative/absolute path
MODEL_PATH=../ml/artifacts/brain-tumor-detection-model.keras

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=*
